
# Generated automatically in .env.local; .env.example must keep this value blank.
BETTER_AUTH_SECRET=
# Set this to your application's public URL in production.
BETTER_AUTH_URL=__DEVELOPMENT_URL__

# Resend API key and a sender on your verified domain. Required for password recovery.
RESEND_API_KEY=
EMAIL_FROM=

# Optional local development login defaults; never use deployment credentials.
DEV_ADMIN_USER=
DEV_ADMIN_PASSWORD=
