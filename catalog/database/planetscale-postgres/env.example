# Complete these database variables in .env.local; preserve its generated auth secret.
# Application: a user-defined role through PgBouncer (port 6432).
# The pg pool is managed with attachDatabasePool for Vercel Fluid Compute.
DATABASE_URL=postgresql://app.your-branch:your-password@your-host.horizon.psdb.cloud:6432/your-database?sslmode=verify-full

# Drizzle Kit: a role with schema permissions, connected directly (port 5432).
DATABASE_URL_DIRECT=postgresql://migrations.your-branch:your-password@your-host.horizon.psdb.cloud:5432/your-database?sslmode=verify-full
